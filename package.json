{
  "name": "forgetful-ui-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Experimental read-only UI mock-up for Forgetful; not production-ready",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "LIVE=1 playwright test tests/e2e/live.spec.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-force-graph-2d": "1.29.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
